#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local model files (hundreds of MB to GB; download them, never commit them)
*.litertlm
*.task
*.tflite
*.gguf

# Evaluation scratch (logs, raw run output). Result JSON files ARE committed.
/evaluation/tmp/
run.log
*.log

# Local tooling
.claude/
.vscode/
